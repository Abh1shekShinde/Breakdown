    <Button fx:id="mechanicViewRatingsButton" layoutX="62.0" layoutY="119.0" onAction="#setViewRating" style="-fx-background-color: #ffffff; -fx-border-color: #6747ce; -fx-border-radius: 20; -fx-background-insets: 000; -fx-background-radius: 20;" text="View Ratings" textFill="#6747ce" />
